{
  "name": "@epicurrents/eeg-module",
  "version": "0.1.1-8",
  "description": "Epicurrents EEG module",
  "keywords": [
    "eeg",
    "biosignal",
    "epicurrents",
    "typescript"
  ],
  "homepage": "https://github.com/epicurrents/eeg-module#readme",
  "bugs": {
    "url": "https://github.com/epicurrents/eeg-module/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": "./dist/config/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./types": "./dist/types/index.d.ts",
    "./vocabulary/*": "./src/components/vocabulary/*",
    "./package.json": "./package.json",
    "./dist/config": "./dist/config/index.js",
    "./dist/runtime": "./dist/runtime/index.js",
    "./dist/types": "./dist/types/index.d.ts"
  },
  "files": [
    "dist/*",
    "src/components/vocabulary/*.json",
    "NOTICE",
    "licenses/*",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:tsc",
    "build:docs": "npx typedoc",
    "build:lib": "vite build",
    "build:tsc": "npm run build:lib && npm run build:types",
    "build:types": "epicurrents-build-types",
    "lint": "npm run lint:src",
    "lint:src": "eslint src",
    "prepack": "npm run build",
    "release": "npm publish --access=public",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epicurrents/eeg-module.git"
  },
  "author": "Sampsa Lohi",
  "license": "Apache-2.0",
  "devDependencies": {
    "@epicurrents/core": "^2.1.0",
    "@eslint/js": "^9.19.0",
    "@microsoft/tsdoc": "^0.14.1",
    "@stylistic/eslint-plugin": "^3.0.0",
    "@stylistic/eslint-plugin-ts": "^3.0.0",
    "asymmetric-io-mutex": "^1.0.0",
    "eslint": "^9.19.0",
    "scoped-event-log": "^3.2.0",
    "typedoc": "^0.27.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.21.0",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "@epicurrents/core": "^2.1.0",
    "asymmetric-io-mutex": "^1.0.0",
    "scoped-event-log": "^3.2.0"
  }
}

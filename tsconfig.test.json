{
  /*
   * Type-check the test suite against the real `@epicurrents/core` types.
   *
   * Deliberately no `paths` entry for the mocks: the runtime substitution happens in vitest.config.ts,
   * and pointing the types at the mocks too would let a test assert against a property only the mock
   * has, which verifies nothing about the class the package ships. `tests/mocks` is excluded for the
   * same reason — the stubs stand in for core at runtime and are not expected to satisfy its types.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,             /* No .d.ts files for tests. */
    "noUnusedLocals": false,          /* A fixture may be built and not used in every case. */
    "noUnusedParameters": false,
    "types": ["node"],                /* Vitest's helpers are imported explicitly, not as globals. */
    "typeRoots": ["../../node_modules/@types", "./node_modules/@types"],
    "paths": {
      "#*": ["src/*"],
      "#root/*": ["./*"]
    }
  },
  "include": ["./tests/**/*", "./src/**/*"],
  "exclude": ["node_modules", "dist", "tests/mocks"]
}

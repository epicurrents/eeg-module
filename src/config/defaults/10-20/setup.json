        { "name": "t7", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:t7|t3)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "T7", "modality": "eeg", "averaged": false, "laterality": "s", "unit": "uV" },

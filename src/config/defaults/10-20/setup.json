        { "name": "c4", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:c4)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "C4", "modality": "eeg", "averaged": false, "laterality": "d", "unit": "uV" },

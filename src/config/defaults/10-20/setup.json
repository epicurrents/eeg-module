{
    "name": "default:10-20",
    "label": "Default IFCN-25",
    "description": ["A generic setup for parsing records against the IFCN 25-electrode array: the 19 electrodes of the 10-20 system plus the inferior chain F9/F10, T9/T10 and P9/P10", "FT9/FT10 and TP9/TP10 are matched as electrodes of their own, as the inferior temporal extras clinical recordings commonly carry in place of or beside the IFCN chain", "Electrodes a recording does not carry go unmatched, so the same setup serves a plain 10-20 record and an extended one"],
    "channels":  [
        { "name": "fp1", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:fp1)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "Fp1", "modality": "eeg", "averaged": false, "laterality": "s", "unit": "uV" },
        { "name": "fp2", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:fp2)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "Fp2", "modality": "eeg", "averaged": false, "laterality": "d", "unit": "uV" },
        { "name": "f3", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:f3)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "F3", "modality": "eeg", "averaged": false, "laterality": "s", "unit": "uV" },
        { "name": "f4", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:f4)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "F4", "modality": "eeg", "averaged": false, "laterality": "d", "unit": "uV" },
        { "name": "f7", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:f7)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "F7", "modality": "eeg", "averaged": false, "laterality": "s", "unit": "uV" },
        { "name": "f8", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:f8)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "F8", "modality": "eeg", "averaged": false, "laterality": "d", "unit": "uV" },

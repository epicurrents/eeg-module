        { "name": "o2", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:o2)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "O2", "modality": "eeg", "averaged": false, "laterality": "d", "unit": "uV" },
        { "name": "fz", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:fz)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "Fz", "modality": "eeg", "averaged": false, "laterality": "z", "unit": "uV" },
        { "name": "cz", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:cz)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "Cz", "modality": "eeg", "averaged": false, "laterality": "z", "unit": "uV" },
        { "name": "pz", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:pz)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "Pz", "modality": "eeg", "averaged": false, "laterality": "z", "unit": "uV" },
        { "name": "f9", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:f9)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "F9", "modality": "eeg", "averaged": false, "laterality": "s", "unit": "uV" },
        { "name": "f10", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:f10)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "F10", "modality": "eeg", "averaged": false, "laterality": "d", "unit": "uV" },
        { "name": "t9", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:t9)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "T9", "modality": "eeg", "averaged": false, "laterality": "s", "unit": "uV" },
        { "name": "t10", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:t10)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "T10", "modality": "eeg", "averaged": false, "laterality": "d", "unit": "uV" },
        { "name": "p9", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:p9)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "P9", "modality": "eeg", "averaged": false, "laterality": "s", "unit": "uV" },
        { "name": "p10", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:p10)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "P10", "modality": "eeg", "averaged": false, "laterality": "d", "unit": "uV" },
        { "name": "ft9", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:ft9)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "FT9", "modality": "eeg", "averaged": false, "laterality": "s", "unit": "uV" },
        { "name": "ft10", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:ft10)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "FT10", "modality": "eeg", "averaged": false, "laterality": "d", "unit": "uV" },
        { "name": "tp9", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:tp9)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "TP9", "modality": "eeg", "averaged": false, "laterality": "s", "unit": "uV" },
        { "name": "tp10", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:tp10)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "TP10", "modality": "eeg", "averaged": false, "laterality": "d", "unit": "uV" },
        { "name": "eog", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?eog\\d*[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "EOG", "modality": "eog", "averaged": false, "unit": "uV" },
        { "name": "loc", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:loc|e1|eogl|leog|eog[\\s._]*l(?:eft)?)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "LOC", "modality": "eog", "averaged": false, "unit": "uV" },
        { "name": "roc", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:roc|e2|eogr|reog|eog[\\s._]*r(?:ight)?)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "ROC", "modality": "eog", "averaged": false, "unit": "uV" },
        { "name": "ekg", "pattern": "^\\s*(?:pol[\\s:._-]*)?(?:(?:e[ck]g[\\s:._-]*)*e[ck]g(?:[\\s._]*(?:\\d+|l|left|r|right)[+]?\\s*-\\s*e[ck]g[\\s._]*(?:\\d+|l|left|r|right)[+]?\\s*$|(?:\\d+|[\\s._]*(?:i{1,3}|avr|avl|avf|v[1-6]))?[+']*\\s*(?:-(?!\\s*(?:l|left|r|right)[+']*\\s*$).*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$)|(?:i{1,3}|avr|avl|avf|v[1-6])[+']*\\s*(?:-(?!\\s*(?:l|left|r|right)[+']*\\s*$).*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$)", "label": "EKG", "modality": "ekg", "averaged": false, "scale": -1, "unit": "uV" },
        { "name": "ecgl", "pattern": "^\\s*(?:pol[\\s:._-]*)?(?:e[ck]g[\\s:._-]*)+(?:l|left)[+]?\\s*(?:-(?!\\s*e[ck]g).*)?$", "label": "EKG-L", "modality": "ekg", "averaged": false, "scale": -1, "unit": "uV" },
        { "name": "ecgr", "pattern": "^\\s*(?:pol[\\s:._-]*)?(?:e[ck]g[\\s:._-]*)+(?:r|right)[+]?\\s*(?:-(?!\\s*e[ck]g).*)?$", "label": "EKG-R", "modality": "ekg", "averaged": false, "scale": -1, "unit": "uV" },
        { "name": "emg", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:emg(?:\\d+|[\\s:._/][^-]*)?|chin\\d?|submental|musc\\w*)[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "EMG", "modality": "emg", "averaged": false, "unit": "uV" },
        { "name": "res", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:resp\\w*|res|chest|thor(?:ax)?|abd(?:omen)?|airflow|flow|nasal)(?:[\\s._]+[a-z]+)?[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "RES", "modality": "res", "averaged": false, "scale": -1, "unit": "uV" },
        { "name": "ps", "pattern": "^\\s*(?:(?:eeg|pol|e[ck]g)[\\s:._-]*)?(?:photic\\w*|phot|flash|strobe)(?:[\\s._]+[a-z]+)?[+']*\\s*(?:-.*|\\s+(?:ref|avg|ave|av|le|car|a[12]|m[12]|cz|g2|gnd|com|re|0)\\b.*)?$", "label": "Photic", "modality": "act", "averaged": false, "polarity": 1, "scale": -5 },
        { "name": "annotations", "pattern": "(.*?)annotation(.*)", "label": "Annotations", "modality": "meta", "averaged": false }
    ]
